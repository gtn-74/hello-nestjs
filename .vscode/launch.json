{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NestJS Debug",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.ts",
      "runtimeExecutable": "/Users/gtn74/.nvm/versions/node/v23.7.0/bin/node",
      "runtimeArgs": ["-r", "ts-node/register"],
      "env": {
        "NODE_ENV": "development",
        "PATH": "/Users/gtn74/.nvm/versions/node/v23.7.0/bin:${env:PATH}"
      },
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"]
    },
    {
      "name": "現在のファイルを実行",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "runtimeExecutable": "/Users/gtn74/.nvm/versions/node/v23.7.0/bin/node",
      "runtimeArgs": ["-r", "ts-node/register"],
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "PATH": "/Users/gtn74/.nvm/versions/node/v23.7.0/bin:${env:PATH}"
      }
    },
    {
      "name": "Jest Tests Debug",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "runtimeExecutable": "/Users/gtn74/.nvm/versions/node/v23.7.0/bin/node",
      "args": ["--runInBand", "--no-cache"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "PATH": "/Users/gtn74/.nvm/versions/node/v23.7.0/bin:${env:PATH}"
      }
    }
  ]
}
